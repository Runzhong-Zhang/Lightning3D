#!/bin/bash
#PBS -N benchmark_dataset
#PBS -P 13004407
#PBS -q normal
#PBS -l select=1:ncpus=4:mem=32GB:ngpus=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -e

cd "$PBS_O_WORKDIR"

module purge
module load miniforge3/25.3.1
module load pytorch/2.10.0-py3-cu12.6

export PYTHONPATH=/app/apps/pytorch/2.10.0-py3-cu12.6/lib/python3.13/site-packages:$PYTHONPATH

python benchmark_dataset.py
